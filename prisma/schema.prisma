generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Merchant {
  id                  String   @id @default(uuid())
  email               String   @unique
  passwordHash        String
  companyName         String
  address             String?
  logoUrl             String?
  lineChannelId       String?
  lineChannelSecret   String?
  lineAccessToken     String?
  lineLiffId          String?
  isActive            Boolean  @default(true)
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  members           Member[]
  services          Service[]
  staff             Staff[]
  bookings          Booking[]
  businessHours     BusinessHour[]
  loyaltyPrograms   LoyaltyProgram[]
  loyaltyCards      LoyaltyCard[]
  reviews           Review[]
  queueSessions     QueueSession[]
  coupons           Coupon[]
  couponClaims      CouponClaim[]
  formTemplates     FormTemplate[]
  formResponses     FormResponse[]
  productCategories ProductCategory[]
  products          Product[]
  orders            Order[]
  drawCampaigns     DrawCampaign[]

  @@map("merchants")
}

model Member {
  id          String   @id @default(uuid())
  merchantId  String
  lineUserId  String
  displayName String?
  phone       String?
  avatarUrl   String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  merchant      Merchant       @relation(fields: [merchantId], references: [id], onDelete: Cascade)
  bookings      Booking[]
  loyaltyCards  LoyaltyCard[]
  reviews       Review[]
  queueEntries  QueueEntry[]
  couponClaims  CouponClaim[]
  formResponses FormResponse[]
  orders        Order[]
  drawEntries   DrawEntry[]

  @@unique([merchantId, lineUserId])
  @@map("members")
}

model Service {
  id              String   @id @default(uuid())
  merchantId      String
  name            String
  description     String?
  price           Decimal  @db.Decimal(10, 2)
  durationMinutes Int
  isActive        Boolean  @default(true)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  merchant      Merchant       @relation(fields: [merchantId], references: [id], onDelete: Cascade)
  staffServices StaffService[]
  bookings      Booking[]

  @@map("services")
}

model Staff {
  id         String   @id @default(uuid())
  merchantId String
  name       String
  specialty  String?
  avatarUrl  String?
  isActive   Boolean  @default(true)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  merchant      Merchant       @relation(fields: [merchantId], references: [id], onDelete: Cascade)
  staffServices StaffService[]
  bookings      Booking[]

  @@map("staff")
}

model StaffService {
  staffId   String
  serviceId String

  staff   Staff   @relation(fields: [staffId], references: [id], onDelete: Cascade)
  service Service @relation(fields: [serviceId], references: [id], onDelete: Cascade)

  @@id([staffId, serviceId])
  @@map("staff_services")
}

model BusinessHour {
  id         String  @id @default(uuid())
  merchantId String
  dayOfWeek  Int
  openTime   String
  closeTime  String
  isClosed   Boolean @default(false)

  merchant Merchant @relation(fields: [merchantId], references: [id], onDelete: Cascade)

  @@unique([merchantId, dayOfWeek])
  @@map("business_hours")
}

model Booking {
  id            String        @id @default(uuid())
  merchantId    String
  memberId      String
  serviceId     String
  staffId       String
  bookingDate   DateTime      @db.Date
  startTime     String
  endTime       String
  customerName  String
  customerPhone String
  notes         String?
  status        BookingStatus @default(PENDING)
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt

  merchant Merchant @relation(fields: [merchantId], references: [id], onDelete: Cascade)
  member   Member   @relation(fields: [memberId], references: [id])
  service  Service  @relation(fields: [serviceId], references: [id])
  staff    Staff    @relation(fields: [staffId], references: [id])
  review   Review?

  @@index([merchantId, staffId, bookingDate, status])
  @@map("bookings")
}

enum BookingStatus {
  PENDING
  CONFIRMED
  CANCELLED
  COMPLETED
}

// ===== Loyalty / Stamp Card =====
model LoyaltyProgram {
  id                String   @id @default(uuid())
  merchantId        String
  name              String
  stampsRequired    Int      @default(10)
  rewardDescription String
  isActive          Boolean  @default(true)
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  merchant Merchant      @relation(fields: [merchantId], references: [id], onDelete: Cascade)
  cards    LoyaltyCard[]

  @@map("loyalty_programs")
}

model LoyaltyCard {
  id          String   @id @default(uuid())
  merchantId  String
  memberId    String
  programId   String
  stamps      Int      @default(0)
  totalEarned Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  merchant Merchant       @relation(fields: [merchantId], references: [id], onDelete: Cascade)
  member   Member         @relation(fields: [memberId], references: [id], onDelete: Cascade)
  program  LoyaltyProgram @relation(fields: [programId], references: [id], onDelete: Cascade)
  events   StampEvent[]

  @@unique([memberId, programId])
  @@map("loyalty_cards")
}

model StampEvent {
  id        String         @id @default(uuid())
  cardId    String
  type      StampEventType
  count     Int            @default(1)
  note      String?
  createdAt DateTime       @default(now())

  card LoyaltyCard @relation(fields: [cardId], references: [id], onDelete: Cascade)

  @@map("stamp_events")
}

enum StampEventType {
  EARN
  REDEEM
}

// ===== Reviews =====
model Review {
  id         String   @id @default(uuid())
  merchantId String
  memberId   String
  bookingId  String?  @unique
  rating     Int
  comment    String?
  createdAt  DateTime @default(now())

  merchant Merchant @relation(fields: [merchantId], references: [id], onDelete: Cascade)
  member   Member   @relation(fields: [memberId], references: [id], onDelete: Cascade)
  booking  Booking? @relation(fields: [bookingId], references: [id])

  @@map("reviews")
}

// ===== Queue / Waitlist =====
model QueueSession {
  id            String   @id @default(uuid())
  merchantId    String
  name          String   @default("候位")
  date          DateTime @db.Date
  isOpen        Boolean  @default(true)
  currentNumber Int      @default(0)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  merchant Merchant     @relation(fields: [merchantId], references: [id], onDelete: Cascade)
  entries  QueueEntry[]

  @@unique([merchantId, date])
  @@map("queue_sessions")
}

model QueueEntry {
  id            String      @id @default(uuid())
  sessionId     String
  memberId      String
  queueNumber   Int
  customerName  String
  customerPhone String
  partySize     Int         @default(1)
  status        QueueStatus @default(WAITING)
  calledAt      DateTime?
  completedAt   DateTime?
  createdAt     DateTime    @default(now())

  session QueueSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  member  Member       @relation(fields: [memberId], references: [id])

  @@map("queue_entries")
}

enum QueueStatus {
  WAITING
  CALLED
  COMPLETED
  CANCELLED
}

// ===== Coupons =====
model Coupon {
  id             String       @id @default(uuid())
  merchantId     String
  title          String
  description    String?
  discountType   DiscountType
  discountValue  Decimal      @db.Decimal(10, 2)
  minSpend       Decimal?     @db.Decimal(10, 2)
  totalLimit     Int?
  perMemberLimit Int          @default(1)
  validFrom      DateTime
  validUntil     DateTime
  isActive       Boolean      @default(true)
  createdAt      DateTime     @default(now())

  merchant Merchant      @relation(fields: [merchantId], references: [id], onDelete: Cascade)
  claims   CouponClaim[]

  @@map("coupons")
}

enum DiscountType {
  PERCENTAGE
  FIXED
}

model CouponClaim {
  id         String      @id @default(uuid())
  couponId   String
  memberId   String
  merchantId String
  claimedAt  DateTime    @default(now())
  redeemedAt DateTime?
  status     ClaimStatus @default(CLAIMED)

  coupon   Coupon   @relation(fields: [couponId], references: [id], onDelete: Cascade)
  member   Member   @relation(fields: [memberId], references: [id])
  merchant Merchant @relation(fields: [merchantId], references: [id], onDelete: Cascade)

  @@unique([couponId, memberId])
  @@map("coupon_claims")
}

enum ClaimStatus {
  CLAIMED
  REDEEMED
  EXPIRED
}

// ===== Forms =====
model FormTemplate {
  id          String   @id @default(uuid())
  merchantId  String
  title       String
  description String?
  fields      Json
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  merchant  Merchant       @relation(fields: [merchantId], references: [id], onDelete: Cascade)
  responses FormResponse[]

  @@map("form_templates")
}

model FormResponse {
  id          String   @id @default(uuid())
  formId      String
  merchantId  String
  memberId    String?
  answers     Json
  submittedAt DateTime @default(now())

  form     FormTemplate @relation(fields: [formId], references: [id], onDelete: Cascade)
  member   Member?      @relation(fields: [memberId], references: [id])
  merchant Merchant     @relation(fields: [merchantId], references: [id], onDelete: Cascade)

  @@map("form_responses")
}

// ===== Orders / Food =====
model ProductCategory {
  id         String   @id @default(uuid())
  merchantId String
  name       String
  sortOrder  Int      @default(0)

  merchant Merchant  @relation(fields: [merchantId], references: [id], onDelete: Cascade)
  products Product[]

  @@map("product_categories")
}

model Product {
  id          String   @id @default(uuid())
  merchantId  String
  categoryId  String?
  name        String
  description String?
  price       Decimal  @db.Decimal(10, 2)
  imageUrl    String?
  isAvailable Boolean  @default(true)
  sortOrder   Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  merchant   Merchant         @relation(fields: [merchantId], references: [id], onDelete: Cascade)
  category   ProductCategory? @relation(fields: [categoryId], references: [id])
  variants   ProductVariant[]
  orderItems OrderItem[]

  @@map("products")
}

model ProductVariant {
  id        String @id @default(uuid())
  productId String
  name      String
  options   Json

  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@map("product_variants")
}

model Order {
  id          String      @id @default(uuid())
  merchantId  String
  memberId    String
  orderNumber String
  status      OrderStatus @default(PENDING)
  subtotal    Decimal     @db.Decimal(10, 2)
  note        String?
  pickupTime  String?
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt

  merchant Merchant    @relation(fields: [merchantId], references: [id], onDelete: Cascade)
  member   Member      @relation(fields: [memberId], references: [id])
  items    OrderItem[]

  @@map("orders")
}

enum OrderStatus {
  PENDING
  CONFIRMED
  PREPARING
  READY
  COMPLETED
  CANCELLED
}

model OrderItem {
  id          String  @id @default(uuid())
  orderId     String
  productId   String
  productName String
  quantity    Int
  unitPrice   Decimal @db.Decimal(10, 2)
  options     Json?

  order   Order   @relation(fields: [orderId], references: [id], onDelete: Cascade)
  product Product @relation(fields: [productId], references: [id])

  @@map("order_items")
}

// ===== Lucky Draw =====
model DrawCampaign {
  id                  String   @id @default(uuid())
  merchantId          String
  title               String
  description         String?
  type                DrawType @default(WHEEL)
  startAt             DateTime
  endAt               DateTime
  maxEntriesPerMember Int      @default(1)
  isActive            Boolean  @default(true)
  createdAt           DateTime @default(now())

  merchant Merchant    @relation(fields: [merchantId], references: [id], onDelete: Cascade)
  prizes   DrawPrize[]
  entries  DrawEntry[]

  @@map("draw_campaigns")
}

enum DrawType {
  WHEEL
  LOTTERY
}

model DrawPrize {
  id           String  @id @default(uuid())
  campaignId   String
  name         String
  description  String?
  probability  Decimal @db.Decimal(5, 4)
  totalCount   Int?
  claimedCount Int     @default(0)

  campaign DrawCampaign @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  entries  DrawEntry[]

  @@map("draw_prizes")
}

model DrawEntry {
  id         String   @id @default(uuid())
  campaignId String
  memberId   String
  prizeId    String?
  isWinner   Boolean  @default(false)
  drawnAt    DateTime @default(now())

  campaign DrawCampaign @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  member   Member       @relation(fields: [memberId], references: [id])
  prize    DrawPrize?   @relation(fields: [prizeId], references: [id])

  @@map("draw_entries")
}
